{
	"extends": "@lucky-parking/configs/typescript/next.json",
	"compilerOptions": {
		"allowJs": true,
		"composite": true,
		"lib": ["ES2024", "DOM"],
		"outDir": "dist",
		"paths": { "@/*": ["./src/*"] },
		"plugins": [{ "name": "next" }],
		"resolveJsonModule": true
	},
	"include": [
		"**/*.d.ts",
		"**/*.json",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		"next-env.d.ts",
		"next.config.ts"
	],
	"exclude": ["node_modules"]
}
