{
	"name": "lucky-parking",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"build:docker:web": "docker build . --file apps/web/Dockerfile --tag lucky-parking/web",
		"check-types": "turbo run check-types",
		"clean": "rm -rf .turbo && turbo run clean",
		"dev": "turbo run dev",
		"format": "turbo run format",
		"lint": "turbo run lint",
		"prepare": "husky",
		"test": "turbo run test"
	},
	"lint-staged": {
		"**/*": [
			"prettier --check --ignore-unknown --config ./packages/configs/src/prettier/prettier.config.mjs"
		],
		"**/*.{cjs,js,jsx,mjs,ts,tsx}": [
			"eslint --fix-dry-run --config ./packages/configs/src/eslint/eslint.config.mjs"
		],
		"**/*.{cts,d.cts,d.mts,d.ts,mts,ts,tsx}": [
			"node ./scripts/typecheck.mjs"
		]
	},
	"devDependencies": {
		"@homer0/prettier-plugin-jsdoc": "catalog:tooling",
		"@trivago/prettier-plugin-sort-imports": "catalog:tooling",
		"@xeonlink/prettier-plugin-organize-attributes": "catalog:tooling",
		"eslint": "catalog:tooling",
		"eslint-config-next": "catalog:tooling",
		"husky": "catalog:tooling",
		"lint-staged": "catalog:tooling",
		"prettier": "catalog:tooling",
		"prettier-plugin-css-order": "catalog:tooling",
		"prettier-plugin-tailwindcss": "catalog:tooling",
		"react": "catalog:",
		"rimraf": "catalog:tooling",
		"turbo": "catalog:tooling"
	},
	"packageManager": "pnpm@12.3.4"
}
