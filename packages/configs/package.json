{
	"name": "@lucky-parking/configs",
	"type": "module",
	"exports": {
		"./*": "./src/*",
		"./tailwind/postcss": "./src/tailwind/postcss.config.js"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"clean": "rimraf .turbo node_modules",
		"format": "prettier . --check --ignore-unknown",
		"format:fix": "prettier . --write --ignore-unknown",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"peerDependencies": {
		"@homer0/prettier-plugin-jsdoc": "^11.0.2",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@typescript/native": "catalog:tooling",
		"@xeonlink/prettier-plugin-organize-attributes": "^1.1.0",
		"eslint": "catalog:tooling",
		"eslint-config-next": "16.1.1",
		"postcss": "^8.5.3",
		"prettier": "catalog:tooling",
		"prettier-plugin-css-order": "^2.2.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"tailwindcss": "^4.1.18",
		"typescript": "catalog:tooling"
		"lint": "eslint . --no-error-on-unmatched-pattern",
		"lint:fix": "eslint . --fix --no-error-on-unmatched-pattern"
	}
}
