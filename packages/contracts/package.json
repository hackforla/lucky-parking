{
	"name": "@lucky-parking/contracts",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"check-types": "tsc --noEmit",
		"clean": "rimraf .turbo dist node_modules",
		"dev": "tsc --watch",
		"format": "prettier . --check --ignore-unknown",
