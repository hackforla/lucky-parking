		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"devDependencies": {
		"@lucky-parking/configs": "workspace:^",
		"@typescript/native": "catalog:tooling",
		"typescript": "catalog:tooling"
	}
}
