{
	"name": "@lucky-parking/design",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./styles.css": "./dist/index.css",
		"./*": "./dist/*/index.js"
	},
	"scripts": {
		"build": "pnpm build:components && pnpm build:styles",
		"build:components": "tsc",
		"build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
		"check-types": "tsc --noEmit",
		"clean": "rimraf .turbo dist node_modules",
		"dev": "concurrently --kill-others-on-fail \"pnpm run dev:components\" \"pnpm run dev:styles\"",
		"dev:components": "tsc --watch",
		"dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
		"format": "prettier . --check --ignore-unknown",
		"format:fix": "prettier . --write --ignore-unknown",
		"lint": "eslint . --no-error-on-unmatched-pattern",
		"lint:fix": "eslint . --fix --no-error-on-unmatched-pattern"
	},
	"dependencies": {
		"@radix-ui/react-accordion": "^1.2.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"lucide-react": "^0.562.0",
		"react": "^19.0.0",
		"react-day-picker": "^9.13.0",
		"react-dom": "^19.0.0",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@lucky-parking/configs": "workspace:^",
		"@tailwindcss/cli": "^4.1.18",
		"@typescript/native": "catalog:tooling",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.0.4",
		"typescript": "catalog:tooling"
	}
}
