{
	"name": "@lucky-parking/design",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./styles.css": "./dist/index.css",
		"./*": "./dist/*/index.js"
	},
	"scripts": {
		"build:components": "tsc",
		"build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
		"check-types": "tsc --noEmit",
		"clean": "rm -rf .turbo node_modules dist",
		"dev:components": "tsc --watch",
		"dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
		"format": "NODE_OPTIONS='--experimental-strip-types' prettier . --check --ignore-unknown",
		"format:fix": "NODE_OPTIONS='--experimental-strip-types' prettier . --write --ignore-unknown"
	},
	"dependencies": {
		"@radix-ui/react-accordion": "^1.2.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"lucide-react": "^0.562.0",
		"react": "^19.0.0",
		"react-day-picker": "^9.13.0",
		"react-dom": "^19.0.0",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@lucky-parking/configs": "workspace:^",
		"@tailwindcss/cli": "^4.1.18",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.0.4",
		"typescript": "latest"
	}
}
