# Copy to .env (optional locally; required for prod compose password).
# docker compose up uses these for PostGIS, API, and explorer.

POSTGRES_DB=lucky_parking
POSTGRES_USER=lucky
POSTGRES_PASSWORD=changeme

# Host ports. Local compose also publishes Postgres :5432.
API_PORT=8000
WEB_PORT=8080

# Optional memory caps
# COMPOSE_MEM_LIMIT=8g
# COMPOSE_MEM_LIMIT_POSTGIS=2560m
# COMPOSE_MEM_LIMIT_API=512m
# COMPOSE_MEM_LIMIT_WEB=512m

# First-boot CSV load. Use 0 locally (load from raw_data/). Use 1 on the VPS and restore a pg_dump.
SKIP_CITATIONS_LOAD=0

# Compose injects DATABASE_URL pointing at hostname "postgis" for api/web.
# Host-side uvicorn / CLI default if unset:
# postgresql://lucky:changeme@localhost:5432/lucky_parking
